# ---- Decision gate (fewer, higher-quality trades) ----
# A BUY is only emitted at/above this confidence (evidence agreement %) —
# otherwise the engine returns WAIT. Confidence is agreement of the signals,
# NOT a guaranteed win probability. NOTE: a flat 90 permanently pinned the
# low-volatility indices (Nifty/Sensex) at WAIT; 66 lets real BUY/PUT calls fire
# on indices too while still demanding a one-sided read. The gate is auto-nudged
# by regime (trend relaxes it, chop tightens it). Raise it for fewer signals.
QT_BUY_MIN_CONFIDENCE=75
# Higher-timeframe TREND-GATE factor (in 1-min candles). The frozen BUY only
# fires with the higher-TF trend (CE in UP / PE in DOWN). Default 5 = the classic
# 5-min gate: safe, but the BUY appears late (after ~6–8 green 1-min candles).
# Set 1 to gate on the 1-min trend → BUY fires as the green run starts, but with
# FAR more false signals. Fully reversible; this is the only frozen timeframe knob.
QT_HTF_FACTOR=5
# A BUY also requires this much one-sided Level-1/2/3 (price-action / premium /
# OI) evidence. Lagging indicators (EMA/RSI/MACD/BB) can only confirm, never
# trigger, a BUY on their own.
QT_BUY_MIN_PRIMARY_STRENGTH=0.30
# --- Signal stability (fewer, higher-conviction trades; less whipsaw) ---
# How strong the OPPOSITE direction must be before the engine EXITs + flips your
# held CALL<->PUT. Higher = only genuine, confirmed reversals flip; small wiggles
# are ridden out (trailing stop handles risk) instead of whipsawing CE/PE.
QT_REVERSAL_MIN_STRENGTH=0.30
# Direction below this |net| = "no clear side" -> WAIT (stops CE/PE flip-flop).
QT_NEUTRAL_DEAD_BAND=0.16
# In a RANGING/choppy regime, suppress fresh directional BUYs and WAIT (ranges
# are where targets stall and signals whipsaw). false = allow range trades.
QT_RANGING_BLOCKS_ENTRY=true
# Entry style (also toggleable live from the Decision screen's "Entry" switch):
#   pullback  = only enter on a pullback/retest, never the breakout candle
#               (safest; can miss clean trends that don't pull back).
#   momentum  = ALSO enter a confirmed trend continuation (5-min trend + 1-min
#               agree, not over-extended) so strong runs are caught.
#   pattern   = the confirmation-candle method: ALSO enter on a closed candle
#               pattern (engulfing / star / hammer / piercing / marubozu) that
#               agrees with the 5-min trend — fires the most often.
QT_ENTRY_MODE=pullback
# Momentum entries need at least this directional strength (0..1) so only
# genuinely strong trends fire a continuation BUY (not weak drift).
QT_MOMENTUM_MIN_STRENGTH=0.34
# While HOLDing and at least this % underwater (but trend still intact), show an
