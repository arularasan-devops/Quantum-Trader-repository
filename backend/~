# --- OPTIONAL: extra Angel keys for multi-key sharding (faster, more headroom) ---
# Each extra SmartAPI "app" (create at https://smartapi.angelbroking.com/ -> My Apps)
# is a separate session with its OWN WebSocket + token budget. Instruments are
# split across all configured keys, so the historical warm-up runs in parallel
# and you get more live tokens. Add _2 (and _3, _4, _5) sets — the app uses them
# automatically. With only the primary key above, behaviour is unchanged.
# SMARTAPI_KEY_2=
# SMARTAPI_CLIENT_CODE_2=  # can be the SAME Angel client id as above
# SMARTAPI_PIN_2=
# SMARTAPI_TOTP_SECRET_2=  # TOTP secret of the SECOND app (each app has its own)
# SMARTAPI_KEY_3=
# SMARTAPI_CLIENT_CODE_3=
# SMARTAPI_PIN_3=
# SMARTAPI_TOTP_SECRET_3=
#
# With 2+ keys, route ALL live orders through the PRIMARY key so real orders
# never queue behind data-fetch rate-limits; quotes/history still shard across
# every key for speed. No effect with a single key. (Model A.)
QT_ORDERS_ON_PRIMARY_ONLY=true
#
# --- Groww Trading API (required when QT_ENABLE_GROWW=true, or QT_DATA_PROVIDER=groww) ---
# Create an API key at https://groww.in/trade-api (Groww app -> Trading API).
# Serves the NSE/BSE (NFO/BFO) index + stock options on a SEPARATE account from
# Angel, so the two feeds don't compete. Groww issues one of TWO key types —
# use the matching secret var (the SDK mints a daily access token for you):
#   * "Approval" key (most common)  -> set GROWW_API_KEY + GROWW_API_SECRET
#   * "TOTP" key                    -> set GROWW_API_KEY + GROWW_TOTP_SECRET (base32)
# Or skip both and paste a ready daily token in GROWW_ACCESS_TOKEN.
# NOTE: the API SECRET is NOT a base32 TOTP seed — putting it in GROWW_TOTP_SECRET
# causes a "Non-base32 digit found" login error. Never hard-code / commit these.
# GROWW_API_KEY=
# GROWW_API_SECRET=         # for an "approval" API key
# GROWW_TOTP_SECRET=        # ONLY for a "TOTP" API key (base32 seed)
# GROWW_ACCESS_TOKEN=       # alternative: a ready daily token (skip the above)
#
