QT_PORT=8000
QT_CORS_ORIGINS=http://localhost:3000

# ---- Market data provider ----
# angelone | simulated | kite | upstox | truedata
# Production/default is "angelone" — REAL live broker data. Fill the SMARTAPI_*
# credentials below. "simulated" exists only for fully-offline development and
# must NOT be used for real analysis (it produces synthetic prices).
QT_DATA_PROVIDER=angelone

# Angel One instrument selection (defaults are correct for MCX Crude Oil).
# QT_ANGEL_SYMBOL_ROOT also sets the instrument analysed at startup; switch it
# live from the dashboard dropdown (CRUDEOIL / NATURALGAS / GOLD / SILVER / COPPER).
QT_ANGEL_EXCHANGE=MCX
QT_ANGEL_SYMBOL_ROOT=CRUDEOIL

# ---- Limit which instruments load (optional) ----
# Comma-separated list. Only these are warmed / streamed / scanned; everything
# else is skipped. FEWER instruments = much faster first load and no Angel history
# throttling (AB1021), because the one-time candle warm-up is per instrument.
# Leave blank to load the full set. Example for a fast focused test:
#   QT_INSTRUMENTS=CRUDEOIL,NATURALGAS
QT_INSTRUMENTS=

# ---- Daily auto-pick: let the app choose today's stocks (optional) ----
# When true, each trading day the app asks Angel for the biggest F&O movers
# (gainers AND losers, by % price) and focuses the dashboard/screener on the top
# QT_AUTO_PICK_COUNT liquid stock options, PLUS the always-on core below. So you
# don't research manually and the feed stays light/fast. Picks refresh once per
# day (see GET /api/auto-pick; add ?refresh=true to re-pick now). Needs the live
# Angel feed; on the simulated feed or if the call fails it uses the core only.
# NOTE: a non-blank QT_INSTRUMENTS above overrides this.
#QT_AUTO_PICK_ENABLED=false
#QT_AUTO_PICK_COUNT=5
#QT_AUTO_PICK_CORE=CRUDEOIL,NIFTY,SENSEX
QT_CREDIT_SPREAD_ENABLED=true
# ---- Groww live feed (optional; complements Angel One) ----
# Angel One caps ONE account at ~1000 tokens / a few WebSockets, so running all
# 25 instruments on it alone throttles the live feed. Enable Groww to split the
# load across TWO independent broker accounts: Angel keeps the MCX commodities
# (Crude/NaturalGas/Gold/…) and Groww serves the NSE/BSE index + stock options
# (Nifty/Sensex/Reliance/SBI/…). Neither account is overloaded, so the live data
# stays fast. With this false (default) nothing changes — Angel serves everything.
QT_ENABLE_GROWW=false

# ---- Order execution ----
# paper = track a simulated position only (NO real orders). Safe default.
# live  = place REAL orders via the broker provider (requires a confirm step).
QT_TRADE_MODE=paper
QT_ANGEL_PRODUCT=INTRADAY       # INTRADAY (MIS) or CARRYFORWARD (NRML)
QT_ANGEL_ORDER_VARIETY=NORMAL   # NORMAL / STOPLOSS
QT_ANGEL_ORDER_TYPE=MARKET      # MARKET / LIMIT

# ---- Paper auto-trader (SIMULATED fills only; never places a real order) ----
# When enabled it auto-enters a paper position on a BUY at/above the confidence
# gate and auto-exits at Target 1 or the stop. Hard-guarded to paper mode: it
# refuses to run whenever QT_TRADE_MODE=live. You can also toggle it live from
# the dashboard (the ⚡ AUTO-TRADE panel) without editing this file.
QT_AUTO_TRADE_ENABLED=true  # true to arm it on startup
QT_AUTO_TRADE_MIN_CONFIDENCE=75 # only auto-buy at/above this conviction %
QT_AUTO_TRADE_MAX_LOTS=1        # HARD upper cap on lots per auto entry
QT_AUTO_TRADE_SAFE_SIZING=true  # size lots by risk% of capital, then cap by max_lots
QT_AUTO_TRADE_RIDE_TRAIL=true   # ride winner with the T1/T2/T3 ratchet target-lock (never gives back a hit target; off = book at T1)
QT_AUTO_TRADE_TRAIL_PCT=10      # legacy trailing stop distance below peak (%), used only when ride-trail is OFF
QT_AUTO_TRADE_MAX_CONCURRENT=3  # max instruments the bot may hold at once (one position per instrument)
QT_AUTO_TRADE_MOMENTUM_ENTRY=false # A) only enter when the entry trigger is live and premium momentum is up (off = enter as soon as the signal says BUY, no waiting)
QT_AUTO_TRADE_NO_CHASE=true        # B) skip already-extended / trap-like moves (no chasing)
QT_AUTO_TRADE_NO_CHASE_TRAP_PROB=60  # skip when buy-trap probability (%) is at/above this
QT_AUTO_TRADE_PRE_T1_TRAIL=true        # exit the running high if it rolls over BEFORE T1 (don't wait forever)
QT_AUTO_TRADE_PRE_T1_TRAIL_ARM_PCT=40  # arm the pre-T1 peak trail once this % of the way from entry to T1
QT_AUTO_TRADE_PRE_T1_TRAIL_GIVEBACK_PCT=30  # exit on giving back this % of the run from the peak (min ~2 pts)
# Per-instrument overrides (JSON). Empty = use the global capital / max-lots for every instrument.
# Capital here is that instrument's own budget; lots here is a HARD fixed size (live caps still apply).
QT_AUTO_TRADE_INSTRUMENT_CAPITAL={}    # e.g. {"NIFTY": 50000, "CRUDEOIL": 60000}
QT_AUTO_TRADE_INSTRUMENT_LOTS={}       # e.g. {"NIFTY": 1, "CRUDEOIL": 1}
QT_DAILY_PROFIT_TARGET=0        # ₹ goal → stop opening NEW trades once reached (0=off; NOT a guaranteed minimum)

# ---- LIVE auto-execution (DANGER: REAL MONEY) ----
# The bot places REAL Angel orders ONLY when ALL THREE hold:
#   QT_TRADE_MODE=live  AND  QT_AUTO_TRADE_ENABLED=true  AND  QT_AUTO_TRADE_ALLOW_LIVE=true
# If the live feed is on but ALLOW_LIVE is false, the bot stays hands-off (no orders).
# The edge is thin and validated on UNDERLYING moves only — live losses are possible.
# Start tiny (small capital, 1 lot), supervise the first sessions, keep the caps low.
QT_AUTO_TRADE_ALLOW_LIVE=true        # master arm for real orders (second, deliberate switch)
QT_AUTO_TRADE_LIVE_MAX_LOTS=1         # hard lots cap for a LIVE auto entry
QT_AUTO_TRADE_LIVE_MAX_ORDER_VALUE=60000  # reject a live auto-BUY above this ₹ notional
# One-click LIVE auto-buy: size each entry from the broker's REAL available cash
# (not the fixed QT_CAPITAL), scaled by the signal's confidence (higher confidence
# = larger share of balance). The Auto-Bot panel's "Live Auto-Buy" button flips
# this on together with ENABLED + ALLOW_LIVE in one action, and auto-sets the
# per-order ₹ cap to your available cash (one order can never exceed your balance).
QT_AUTO_TRADE_USE_LIVE_BALANCE=true

QT_AI_ENABLED=true          # compute + journal AI decisions (read-only, no trades)
QT_AI_PAPER_ENABLED=true    # let the AI open/manage its own PAPER positions
QT_AI_PAPER_CAPITAL=500000  # notional AI paper account
QT_AI_MIN_PROBABILITY=0.55  # P(target before stop) needed for BUY_NOW

# ---- Zero-to-Hero expiry sleeve (SPECULATIVE / HIGH RISK / SEPARATE budget) ----
# A tiny EXPIRY-DAY punt: buy a cheap far-OTM option in the day's bias direction.
# Can multiply, but usually expires WORTHLESS. NO backtest, NO edge — not the safe
# strategy. Walled off: it can never lose more than QT_ZERO_TO_HERO_BUDGET in a day.
# Advisory unless the bot is also armed for live (same live switches as the core).
QT_ZERO_TO_HERO_ENABLED=true         # arm the expiry sleeve
QT_ZERO_TO_HERO_BUDGET=5000           # ₹ you are willing to LOSE ENTIRELY per day
QT_ZERO_TO_HERO_MIN_PREMIUM=2         # cheap-leg premium window (₹) — lower bound
QT_ZERO_TO_HERO_MAX_PREMIUM=40        # cheap-leg premium window (₹) — upper bound
QT_ZERO_TO_HERO_OTM_STEPS=4           # strikes beyond ATM to reach for
QT_ZERO_TO_HERO_EXPIRY_ONLY=true      # only fire on the actual expiry day

# ---- Risk Management v2 (stop-loss refinement + Pre-Trade Validator) ----
# Feature-flagged, fully reversible. Runs AFTER the frozen engine and touches
# ONLY the stop + validation layer (never entry logic / confidence / strategy).
# When on: the premium stop is refined with a Greeks-aware (Delta+Gamma) model,
# and a BUY that fails validation is REJECTED (shown as AVOID with reasons)
# instead of being forced onto an unrealistic stop. Set false to restore the
# exact prior behaviour.
QT_RISK_V2_ENABLED=false
QT_RISK_V2_MAX_PREMIUM_LOSS_PCT=40   # reject a BUY whose stop risks > this % of premium
QT_RISK_V2_MIN_REWARD_RISK=1.2       # reject a BUY with reward:risk below this
QT_RISK_V2_MIN_OI=0                  # min open interest (0 = liquidity floor off)
QT_RISK_V2_MIN_VOLUME=0              # min traded volume (0 = liquidity floor off)
QT_RISK_V2_MAX_SPREAD_PCT=5          # max bid/ask spread % (only when feed gives bid/ask)

# ---- Execution Intelligence Layer (Phase 3.6; ADVISORY, feature-flagged) ----
# Runs AFTER Risk v2 and BEFORE the final recommendation. It NEVER changes the
# BUY/WAIT direction, confidence, or strategy — it only advises execution quality
# (enter now / wait for a better entry / change strike / skip) and explains why.
# Off by default → the app behaves exactly as before.
QT_EXECUTION_INTELLIGENCE_ENABLED=false
QT_EXEC_EXTENDED_ATR=1.5    # >this many ATR beyond VWAP = "extended", advise a pullback
QT_EXEC_SURVIVAL_MIN=60     # trade-survival score below this → advise WAIT/CHANGE/SKIP
QT_EXEC_STRIKE_SEARCH=2     # strikes either side to evaluate for a more resilient leg

# ---- Early Momentum Advisory Engine (ADVISORY, feature-flagged, PARALLEL) ----
# A SECOND, independent engine that runs alongside the frozen confirmation engine.
# It flags an EARLY BUY when a NEW trend is *starting* — first higher-low (lower-
# high for shorts) + VWAP reclaim + rising volume + improving option chain +
# underlying confirmation — i.e. materially earlier than the confirmation BUY,
# WITHOUT trying to catch the exact bottom. It also runs a Signal Delay Analyzer
# that measures how much of each move was already gone at the confirmation BUY.
# It NEVER changes the frozen engine's signal/confidence/strategy. Off by default.
QT_EARLY_MOMENTUM_ENABLED=true
QT_EARLY_MOMENTUM_MIN_SCORE=60        # aligned-evidence score (0..100) to advise EARLY BUY
QT_EARLY_MOMENTUM_MAX_ATR_FROM_VWAP=1.2  # reject once price is this many ATR past VWAP (not "early")
QT_SIGNAL_DELAY_LATE_PCT=50           # flag a confirmation BUY "late" once this % of the move is gone

# ---- Early-Early Mode (Stage 2.5; SEPARATE add-on, ADVISORY, feature-flagged) ----
# An even-earlier advisory tier that sits BETWEEN Stage 2 (Structure) and Stage 3
# (Early Buy). It fires only when MULTIPLE evidence pieces align at once (first
# higher-low + a bullish VWAP-reclaim candle + above-average volume + positive
# EMA slope + improving option-chain + adequate room before resistance) AND the
# leg passes reward:risk >= 2:1 and liquidity validation — NEVER on one green
# candle. Completely isolated from the frozen engine and the Early Momentum
# logic; advisory-only, never auto-executed. Off by default → the tool behaves
# exactly as before unless enabled.
QT_EARLY_EARLY_ENABLED=true
QT_EARLY_EARLY_MIN_EVIDENCE=5         # of the six evidence pieces, how many must pass
QT_EARLY_EARLY_MIN_RR=2.0             # minimum reward:risk (to Target 1) before issuing
QT_EARLY_EARLY_MAX_SPREAD_PCT=8       # reject illiquid legs (only when feed gives bid/ask)
QT_EARLY_EARLY_MIN_ROOM_ATR=1.5       # min ATR of room to resistance/support before issuing

# ---- Quick Scalp Engine (SEPARATE add-on, ADVISORY, feature-flagged) ----
# A dedicated SHORT-duration scalp engine for small 8–20 point OPTION-premium
# moves off EXHAUSTION / BOUNCE setups (a selling/buying climax + ATR stretch from
# VWAP + support/resistance rejection + volume spike + first higher-low/lower-high
# + micro-structure break + option-premium stabilization). It also drives a LIVE
# EXIT alert that flashes "EXIT NOW" the moment a running scalp rolls over.
# Completely independent of the frozen engine, Early Momentum and Early-Early;
# advisory-only, NEVER auto-executed. Off by default → the tool behaves exactly as
# before unless enabled.
QT_SCALP_ENABLED=false
QT_SCALP_MIN_CONDITIONS=5             # of the seven conditions, how many must align
QT_SCALP_TARGET_POINTS=10.0           # fixed OPTION-premium objective (raise toward 15–20 for bigger scalps)
QT_SCALP_MIN_RR=1.5                   # minimum reward:risk (tight-stop model) before issuing
QT_SCALP_MIN_ATR_EXTENSION=1.5        # ATR of stretch from VWAP that flags exhaustion
QT_SCALP_BREAKEVEN_FRAC=0.5           # move stop to breakeven once premium travels this fraction of target
QT_SCALP_MAX_HOLD_CANDLES=6           # hard time-stop: exit after this many candles if target not hit

# ---- Candle-Flow engine (SEPARATE "Flow" dashboard tab) ----
# A raw 1-minute candle rider on its own tab: BUY while the candle prints
# GREEN in the moving direction, HOLD while green, EXIT the instant it turns
# RED (or the premium gives back ~QT_FLOW_GIVEBACK_POINTS from its peak), and
# auto-SWITCH CE↔PE when the flow flips. It DELIBERATELY drops the VWAP-distance,
# score and room-to-resistance gates so it fires early — higher risk, more fakes.
# Completely independent of the frozen engine, Early Momentum, Early-Early and
# Quick Scalp; advisory-only, NEVER auto-executed; logged to its own
# flow_signals.jsonl (read-only /api/flow-report). Off by default.
QT_FLOW_ENABLED=true
QT_FLOW_MIN_BODY_FRAC=0.30            # a candle is "decisive" only if its body is ≥ this fraction of its full range
QT_FLOW_GIVEBACK_POINTS=4.0           # ratcheting trail: EXIT once the premium gives back this many points from its running peak (your 3–5 pt trail)
QT_FLOW_CONFIRM_CANDLES=2            # de-whipsaw: consecutive decisive candles needed before BUY / side-flip / colour-turn EXIT (1=twitchy, 2=steady)
QT_FLOW_STICKY_CANDLES=3             # how many candles a fresh entry keeps the big "just entered" BUY tag
QT_FLOW_PAPER_LOTS=1                 # PAPER-ONLY lots used to turn Flow points into a ₹ P&L in the history (never sizes a real order)
# NOTE: Flow paper-lots + trail give-back are ALSO editable live from the Flow
# dashboard tab (dashboard settings are preferred; these env values are just the
# startup defaults). Flow is PAPER-ONLY and has NO live-order path by design —
# the measured edge does not survive real option costs, so never size up on it.

