# ==========================================================================
# Quantum Trader — environment configuration
# Copy to .env and adjust. NEVER commit a real .env (see .gitignore).
# ==========================================================================

# ---- Backend server ----
QT_HOST=0.0.0.0
QT_PORT=8000
QT_CORS_ORIGINS=http://localhost:3000

# ---- Market data provider ----
# simulated | angelone | groww   (see backend/app/market/provider.py::build_provider)
# A real provider that cannot log in / stream reports DISCONNECTED and never
# falls back to simulated prices.
# "simulated" runs fully offline. Switch once broker credentials are provided.
QT_DATA_PROVIDER=simulated

# ---- Instrument ----
QT_UNDERLYING_SYMBOL=MCX:CRUDEOIL
QT_TRADINGVIEW_SYMBOL=MCX:CRUDEOIL
QT_LOT_SIZE=100
QT_TICK_INTERVAL_SECONDS=1.0
QT_CANDLE_INTERVAL_SECONDS=60

# ---- Simulated feed ----
QT_SIM_START_PRICE=6900
QT_SIM_ANNUAL_VOL=0.35
QT_SIM_SEED=0

# ---- Options model ----
QT_RISK_FREE_RATE=0.065
QT_STRIKE_STEP=50
QT_STRIKES_EACH_SIDE=10
QT_DAYS_TO_EXPIRY=7

# ---- Costs ----
QT_BROKERAGE_PER_LOT=20

# ==========================================================================
# Broker credentials (only needed when QT_DATA_PROVIDER != simulated).
# Provide via your secrets manager / environment — do NOT hard-code.
# ==========================================================================
# KITE_API_KEY=
# KITE_API_SECRET=
# UPSTOX_API_KEY=
# UPSTOX_API_SECRET=
# SMARTAPI_KEY=
# TRUEDATA_USER=
# TRUEDATA_PASSWORD=

# ---- Frontend (Next.js public vars) ----
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WS_BASE=ws://localhost:8000
NEXT_PUBLIC_TV_SYMBOL=MCX:CRUDEOIL

# ---- Persistence ----
# Required by docker-compose (PostgreSQL superuser password for the `quantum`
# DB). Use URL-safe characters only (A-Z a-z 0-9 - _ .) because Compose embeds
# it in QT_DB_URL for the backend container.
POSTGRES_PASSWORD=change-me-local-only
# Host (non-Compose) runs only. Empty = SQLite under QT_DATA_DIR. Inside
# Compose this is overridden to postgresql://quantum:...@postgres:5432/quantum.
QT_DB_URL=

# ---- Trading mode & paper auto-trader ----
# This deployment is PAPER only: simulated fills, no broker orders. Any value
# other than paper/live disables automatic trading at startup (fails closed).
QT_TRADE_MODE=paper
# Auto-evaluate signals and auto-enter eligible PAPER trades. Entries are gated
# to PULLBACK setups in a TRENDING regime at >= 80% confidence (backend-enforced).
QT_AUTO_TRADE_ENABLED=true
QT_AUTO_TRADE_MIN_CONFIDENCE=80

# ---- Capital & live-arming controls ----
# Single strategy-capital source of truth (₹). Runtime changes may only lower it.
QT_CAPITAL=500000
# Paper account starting balance shown on the Account tab (equity = this + realised paper P&L).
QT_PAPER_CAPITAL=500000
# Shared secret required in the X-QT-Live-Token header to arm live trading,
# place live orders, or release the kill switch. Empty = live arming refused.
QT_LIVE_ARM_TOKEN=

# --- Paper auto-buy (TRENDING + PULLBACK + executable quote + risk gate) ---
QT_AUTO_TRADE_CAPITAL_SIZING=true   # PAPER: lots = as many as free capital buys at the ask (no fixed cap)
QT_MAX_DAILY_LOSS=0                 # 0 = no daily loss stop
QT_DAILY_PROFIT_TARGET=30000        # arms the profit lock (auto-buy continues above it)
# v3.5 loss protection (PAPER). Lock keeps 75% of the day high, never below the target.
QT_DAILY_LOCK_KEEP_PCT=75
QT_DAILY_LOCK_ROOM_SHARE_PCT=50       # a new trade may risk only this % of the room above the lock
QT_AUTO_TRADE_MAX_LOSS_RUPEES=10000   # most one auto trade may lose at its stop (lots cut to fit)
QT_AUTO_TRADE_SLIPPAGE_BUFFER_PCT=1   # added to the stop distance when sizing
QT_AUTO_TRADE_EXIT_ON_BID=true        # stops/targets/lock judged on the bid (the real sell price)
QT_TRADE_PATH_RECORD_SEC=5            # record open-trade bid/ask/LTP every N seconds
QT_DAILY_PEAK_GIVEBACK=0            # lock = day peak - this (never below target); 0 = exact peak
QT_PROFIT_LOCK_FLATTEN=true         # back under the target after reaching it -> close auto positions
# Staged exits after T1
QT_TIER_T1_GIVEBACK_PCT=60
QT_TIER_T2_GIVEBACK_PCT=50
QT_TIER_T3_RUNNER_TRAIL_PCT=8

# DB backups to ./backups: rolling copies every N min + one per day
QT_BACKUP_EVERY_MIN=5
QT_BACKUP_KEEP=12
QT_BACKUP_KEEP_DAYS=7
QT_AUTO_TRADE_PRE_T1_TRAIL_ARM_RUPEES=10000

# v3.5.14 LIVE parity (only matter when QT_TRADE_MODE=live)
QT_AUTO_TRADE_LIVE_PULLBACK_ENGINE=true
QT_AUTO_TRADE_LIVE_CAPITAL_SIZING=true
QT_AUTO_TRADE_LIVE_EXIT_ON_BID=true
QT_AUTO_TRADE_LIVE_SQUAREOFF_EQUITY_IST=15:15
QT_AUTO_TRADE_LIVE_SQUAREOFF_MCX_IST=23:15
